# Postgres local de desarrollo (docker-compose.yml)
# Independiente del Postgres del VPS, que se configura al deployar.
# Puerto expuesto en 5433 (no 5432) porque el 5432 del host puede estar
# ocupado por Postgres de otros proyectos corriendo en esta máquina.
POSTGRES_USER=tattoo_studio
POSTGRES_PASSWORD=tattoo_studio_dev
POSTGRES_DB=tattoo_studio_dev
POSTGRES_PORT=5433
