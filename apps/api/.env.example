# Connection string al Postgres local levantado por docker-compose.yml
# (raíz del monorepo). Usuario/password/db y puerto deben coincidir con
# el .env de la raíz.
DATABASE_URL="postgresql://tattoo_studio:tattoo_studio_dev@localhost:5433/tattoo_studio_dev?schema=public"

# Access Token de Mercado Pago. Este es un Access Token de PRUEBA (sandbox,
# empieza con TEST-), sacado del panel de credenciales de un usuario de
# prueba en https://www.mercadopago.com.ar/developers/panel/app.
# ⚠️ Al pasar a producción, reemplazar por el Access Token real (empieza con
# APP_USR-) y NUNCA commitear ese valor real — solo va en el .env local/del
# servidor, nunca en este .env.example.
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
