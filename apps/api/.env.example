# Connection string al Postgres local levantado por docker-compose.yml
# (raíz del monorepo). Usuario/password/db y puerto deben coincidir con
# el .env de la raíz.
DATABASE_URL="postgresql://tattoo_studio:tattoo_studio_dev@localhost:5433/tattoo_studio_dev?schema=public"

# Access Token de Mercado Pago. Este es un Access Token de PRUEBA (sandbox,
# empieza con TEST-), sacado del panel de credenciales de un usuario de
# prueba en https://www.mercadopago.com.ar/developers/panel/app.
# ⚠️ Al pasar a producción, reemplazar por el Access Token real (empieza con
# APP_USR-) y NUNCA commitear ese valor real — solo va en el .env local/del
# servidor, nunca en este .env.example.
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"

# Resend (emails de confirmación de turno). API key de la cuenta de Resend:
# https://resend.com/api-keys
RESEND_API_KEY="re_000000000_00000000000000000000000000"

# Remitente de los emails. "onboarding@resend.dev" es el remitente de prueba
# que da Resend por default — funciona sin verificar un dominio propio, pero
# solo entrega a la casilla dueña de la cuenta de Resend. Reemplazar por un
# remitente del dominio propio ya verificado en Resend al pasar a producción.
NOTIFICATION_FROM_EMAIL="onboarding@resend.dev"

# A dónde llega el aviso interno de "nueva reserva confirmada". Por ahora el
# mail personal de quien está desarrollando esto; reemplazar por el mail del
# estudio cuando lo tengan.
STUDIO_NOTIFICATION_EMAIL="tu-email-personal@example.com"

# Clave del panel de administración (/api/admin/*) — el frontend la manda en
# el header x-admin-key en cada request, el AdminGuard la compara contra
# esto. Generar una propia con `openssl rand -hex 32`, nunca reusar la de
# ejemplo. Es la URL de acceso al panel (apps/web: /turnos/[code]), tratarla
# como una contraseña.
ADMIN_API_KEY="reemplazar-con-openssl-rand--hex-32"
