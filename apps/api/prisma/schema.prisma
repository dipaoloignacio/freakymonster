generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id          String   @id @default(cuid())
  name        String
  bio         String?
  specialties String[]
  imageUrl    String?
  active      Boolean  @default(true)

  services     ArtistService[]
  availability WeeklyAvailability[]
  blocks       AvailabilityBlock[]
  appointments Appointment[]
}

model Service {
  id              String   @id @default(cuid())
  name            String
  durationMinutes Int
  requiresDeposit Boolean  @default(false)
  depositAmount   Decimal? @db.Decimal(10, 2)
  active          Boolean  @default(true)

  artists      ArtistService[]
  appointments Appointment[]
}

model ArtistService {
  artistId  String
  serviceId String

  artist  Artist  @relation(fields: [artistId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([artistId, serviceId])
}

model WeeklyAvailability {
  id        String @id @default(cuid())
  artistId  String
  dayOfWeek Int // 0 = domingo ... 6 = sábado
  startTime String // "12:00"
  endTime   String // "20:00"

  artist Artist @relation(fields: [artistId], references: [id])
}

model AvailabilityBlock {
  id       String   @id @default(cuid())
  artistId String
  date     DateTime @db.Date
  reason   String?

  artist Artist @relation(fields: [artistId], references: [id])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum DepositStatus {
  NONE
  PENDING
  PAID
}

model Appointment {
  id            String            @id @default(cuid())
  artistId      String
  serviceId     String
  customerName  String
  customerPhone String
  customerEmail String?
  startTime     DateTime
  endTime       DateTime
  status        AppointmentStatus @default(PENDING)
  depositStatus DepositStatus     @default(NONE)
  notes         String?
  // Solo se setea para turnos PENDING de servicios que requieren seña (15
  // min desde la creación). null = no expira (ni requiere seña, ni ya está
  // CONFIRMED). Ver AppointmentsService.create() y AppointmentExpiryCleanup.
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())

  artist  Artist  @relation(fields: [artistId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  // Las gift cards que se canjearon en este turno. Es una lista y no un
  // vínculo 1-1 a propósito: todavía no está definido si una reserva puede
  // pagarse con más de una gift card, y un @unique acá sería una decisión
  // difícil de revertir después (habría que limpiar datos). Al revés —
  // agregarlo cuando la fase de canje defina la regla— es trivial.
  redeemedGiftCards GiftCard[]
}

/// Montos de gift card que ofrece el estudio. El estudio los edita desde el
/// panel; el público solo ve los activos (fase de compra).
model GiftCardTier {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(10, 2)
  label  String?
  active Boolean @default(true)

  // Sin relación a GiftCard a propósito: ver el comentario de GiftCard.amount.
}

enum GiftCardStatus {
  /// Creada, esperando que se confirme el pago. Es el estado inicial: la fila
  /// existe desde antes de pagar porque el external_reference de Mercado Pago
  /// tiene que apuntar a algo. Una card PENDING no tiene código ni sirve para
  /// nada — recién al confirmarse el pago pasa a ACTIVE.
  PENDING
  ACTIVE
  REDEEMED
  EXPIRED
}

model GiftCard {
  id String @id @default(cuid())

  /// Formato FM-XXXX-XXXX con un alfabeto sin caracteres confundibles — se
  /// dicta por teléfono y se escribe a mano. Ver generateGiftCardCode() en
  /// src/common/gift-card-code.ts. @unique ya crea el índice.
  ///
  /// null mientras está PENDING: el código se genera recién cuando el pago se
  /// confirma. Que no exista antes es la garantía más fuerte de que una card
  /// impaga no se puede canjear — más que cualquier chequeo de estado, porque
  /// no hay nada que tipear. En Postgres el @unique permite varios NULL.
  code String? @unique

  /// Snapshot del monto al momento de la compra, NO una FK a GiftCardTier:
  /// el estudio puede cambiarle el precio a un tier mañana, y esta card ya se
  /// pagó a un valor fijo. Guardar la referencia haría que su valor mutara
  /// solo, retroactivamente.
  amount Decimal        @db.Decimal(10, 2)
  status GiftCardStatus @default(PENDING)

  purchaserName  String
  purchaserEmail String

  // Regalar es opcional: alguien puede comprarla para sí mismo.
  recipientName  String?
  recipientEmail String?
  message        String? @db.VarChar(500)

  /// Pago de Mercado Pago que la generó, para trazabilidad. Opcional porque
  /// una card emitida a mano por el estudio no tiene pago online detrás.
  mpPaymentId String?

  /// Se calcula al CONFIRMARSE EL PAGO (GIFT_CARD_VALIDITY_MONTHS desde ese
  /// momento), no lo pone la base: el default vive en código para poder
  /// cambiarlo sin migrar. null mientras está PENDING — la vigencia empieza a
  /// correr cuando la card existe de verdad, no cuando alguien abrió el
  /// checkout y lo abandonó.
  expiresAt DateTime?

  redeemedAt              DateTime?
  redeemedByAppointmentId String?
  createdAt               DateTime  @default(now())

  redeemedByAppointment Appointment? @relation(fields: [redeemedByAppointmentId], references: [id])
}
