# URL base del backend que consume el wizard de reserva (ver lib/api.ts).
#
# En desarrollo local, web (3000) y api (3001) son orígenes distintos:
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
#
# En producción todo vive bajo el mismo dominio detrás de Nginx (/api/*),
# así que es simplemente una ruta relativa — no hace falta el dominio:
# NEXT_PUBLIC_API_URL=/api
#
# ⚠️ Empieza con NEXT_PUBLIC_: Next.js la incrusta en el bundle del cliente
# en tiempo de BUILD, no de runtime. Si se cambia, hay que rebuildear
# (ver apps/web/Dockerfile, build arg NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
